__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
build/
dist/
.coverage
*.swp
.DS_Store

# Lambda packaging output
function.zip

# Terraform local state and provider plugins (not state — that's in S3)
terraform/.terraform/
terraform/.terraform.tfstate.lock.info
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/*.tfvars.local

# Kenning lexicon DB now lives at ~/.wyrd/lexicon.db (wyrd-366); the
# in-repo path is a legacy migration target, auto-moved on first CLI
# invocation.
wyrd/generators/kenning/data/lexicon.db

# Public-domain etymology corpus — fetch instructions in sources/MANIFEST.md.
# OCR books and OS OpenNames CSVs (~1.8G) are not committed.
sources/*
!sources/MANIFEST.md

# OS Open Names L2 dump (wyrd-3ypp) — regenerated from sources/ CSV;
# too large for git (~30-50MB after filtering to populated places).
data/mining/os_open_names.jsonl

# Beads / Dolt files (added by bd init)
.dolt/
*.db
# Exception: the kenning runtime seed DB (wyrd-d90t PR 2) is the one
# committed binary in this repo — small enough to ship, regenerable
# via `wyrd kenning lexicon export-runtime-db --dev`. See
# wyrd/generators/kenning/data/seed-runtime.README.md for the regen
# story.
!wyrd/generators/kenning/data/seed-runtime.db
.beads-credential-key

# Local Claude Code agent state — do not commit
.claude/scheduled_tasks.lock
uv.lock
.claude/worktrees/
data/mining/phase2_failures/

# Staged-miner per-chunk crash-safety logs (wyrd-w7i3).
# Transient; promoted to canonical data/mining/phase2/<source>.jsonl
# on source completion via recover-inprogress-chunks. Committing
# these would risk rolling back canonical files (see wyrd-4yze).
data/mining/phase2/_inprogress/

# Transitional phase-2 candidate output: the unresolved-mentions dump
# (~128 MB, regenerated by ingest-toponym-mentions). The resolved
# per-source candidate files in this dir ARE committed; only the
# unresolved firehose is ignored.
data/mining/phase2_candidates/unresolved.jsonl

# Operator scratch space — transitional files, audit CSVs, ad-hoc
# analyses, anything not intended for commit. Stays out of git so the
# repo root stays clean.
scratch/

# Legacy audit-output paths at the repo root — historically created
# by ad-hoc audit runs (wyrd-36ez). Now live under scratch/ but kept
# ignored at root in case future tooling drops them here again.
# Leading slash anchors at repo root so committed paths like
# data/audit/ (operator-maintained allowlists) are NOT caught.
/audit/
/audit-cleaned/

# wyrd-d24: dashboard report snapshots are transitional progress-
# monitoring artifacts — the durable, queryable record now lives in the
# report_snapshot / report_metric DB tables (regenerate with
# `lexicon ingest-report-snapshot`). Keep the report dirs out of git.
data/mining/reports/

# Regenerable bundle exports (`export-meanings` output). These are
# large (100MB+, over GitHub's push limit) and rebuildable from the L3
# DB, so they never belong in git wherever they land.
meanings_*.json
